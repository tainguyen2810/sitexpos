# SiteX Post — docker compose settings. Copy to .env next to docker-compose.yml.
# This is NOT Laravel's .env: the web installer writes that one into the `config` volume.

# Image and version (a git tag such as 1.0.0, or "latest")
SITEX_IMAGE=ghcr.io/tainguyen2810/sitexpos
SITEX_VERSION=latest

# Public URLs (https, no trailing slash). Each one is a reverse proxy on the host.
SITEX_PUBLIC_API_URL=https://api.staging.example.com
SITEX_PUBLIC_APP_URL=https://app.staging.example.com
SITEX_PUBLIC_ADMIN_URL=https://admin.staging.example.com

# Local ports the host proxy forwards to (bound to 127.0.0.1 only)
SITEX_PORT_API=8080
SITEX_PORT_APP=8081
SITEX_PORT_ADMIN=8082

# MySQL 8.4 inside the stack. Use long random passwords (openssl rand -base64 24).
MYSQL_DATABASE=sitexpost
MYSQL_USER=sitexpost
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
