# Keep the build context small and never ship local secrets or state.
.git
.github
**/node_modules
**/.DS_Store
backend/vendor
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/*.key
backend/storage/app/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing
backend/storage/logs/*
backend/bootstrap/cache/*.php
frontend/dist
# Only the plugin source is shipped (served as a download by the API).
wordpress-plugin/dist
wordpress-plugin/scripts
wordpress-plugin/tests
docs
scripts
# deploy/: only update.sh is shipped (update.sh refreshes itself from the image).
deploy/supervisor
deploy/docker/*.yml
deploy/docker/env.example
deploy/docker/.env
*.log
