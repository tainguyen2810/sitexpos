APP_NAME="SiteX Post"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL of THIS API (signed email-verification links use it)
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

# SPA origins (CORS + links in emails)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitexpost
DB_USERNAME=sitexpost
DB_PASSWORD=

# database driver is required for "active sessions" management
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production: .yourdomain.com  (shared by app., admin., api.)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts (with port) whose browser requests get cookie/session auth
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: log (or Mailpit smtp 127.0.0.1:1025). Production: SMTP / Brevo SMTP relay.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sitexpost.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SiteX Post
SITEX_INVITATION_EXPIRE_DAYS=7
SITEX_IMPERSONATION_MAX_MINUTES=30
# Development only — ignored when APP_ENV=production
SITEX_SSRF_ALLOW_HOSTS=
SITEX_SSRF_ALLOW_HTTP=false

# Phase 2 — WordPress connector
# Public URL of this API as WordPress sites reach it (the plugin calls {url}/connector/v1/...)
SITEX_CONNECTOR_PUBLIC_URL="${APP_URL}"
SITEX_PAIRING_TTL_MINUTES=15
SITEX_HEALTH_INTERVAL_MINUTES=30
SITEX_MEDIA_MAX_BYTES=10485760

# --- Phase 3: AI Gateway (keys are read from env only; never stored in DB or logs)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Offline "fake" provider for dev/tests. Defaults to true outside production.
SITEX_AI_FAKE_PROVIDER=true
SITEX_AI_CONNECT_TIMEOUT=5
SITEX_AI_MAX_BACKOFF_SECONDS=8
SITEX_AI_CALL_DEADLINE_SECONDS=240
SITEX_AI_RESERVATION_TTL_MINUTES=30
SITEX_AI_MAX_PROMPT_CHARS=20000
SITEX_AI_REQUEST_LOG_RETENTION_DAYS=90
SITEX_RATE_AI_TASKS_PER_MINUTE=20

# --- Phase 3: Workflow engine
SITEX_WORKFLOW_TENANT_CONCURRENCY=2
SITEX_WORKFLOW_LEASE_SECONDS=360
SITEX_WORKFLOW_BACKOFF_BASE=15
SITEX_WORKFLOW_BACKOFF_MAX=900
SITEX_WORKFLOW_DEFER_SECONDS=10
SITEX_WORKFLOW_STALE_PENDING_SECONDS=600
SITEX_WORKFLOW_RETENTION_DAYS=90
