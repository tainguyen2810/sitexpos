includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
    databaseMigrationsPath:
        - app/Modules/Agent/Database/Migrations
        - app/Modules/AiGateway/Database/Migrations
        - app/Modules/Analytics/Database/Migrations
        - app/Modules/Billing/Database/Migrations
        - app/Modules/Audit/Database/Migrations
        - app/Modules/Identity/Database/Migrations
        - app/Modules/Media/Database/Migrations
        - app/Modules/Platform/Database/Migrations
        - app/Modules/Publishing/Database/Migrations
        - app/Modules/Research/Database/Migrations
        - app/Modules/Seo/Database/Migrations
        - app/Modules/Sites/Database/Migrations
        - app/Modules/Workflows/Database/Migrations
        - app/Modules/Workspace/Database/Migrations
        - app/Modules/Writer/Database/Migrations
        - database/migrations
