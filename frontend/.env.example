# Production: https://api.yourdomain.com  (empty = same origin, used in dev with the Vite proxy)
VITE_API_BASE_URL=
# Customer app URL (admin uses it to open impersonation sessions)
VITE_CUSTOMER_APP_URL=http://localhost:5173
# Dev only: Laravel server the Vite proxy forwards /api and /sanctum to
VITE_DEV_API_PROXY=http://localhost:8000
